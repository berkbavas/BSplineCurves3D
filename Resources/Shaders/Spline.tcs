#version 450 core

layout(vertices = 4) out;

uniform int uNumberOfSegments;
uniform int uNumberOfSectors;

void main()
{
    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;

    gl_TessLevelInner[0] = float(uNumberOfSegments);
    gl_TessLevelInner[1] = float(uNumberOfSectors);

    gl_TessLevelOuter[0] = gl_TessLevelInner[1];
    gl_TessLevelOuter[1] = gl_TessLevelInner[0];
    gl_TessLevelOuter[2] = gl_TessLevelInner[1];
    gl_TessLevelOuter[3] = gl_TessLevelInner[0];    
}